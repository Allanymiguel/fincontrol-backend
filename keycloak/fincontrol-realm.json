{
  "realm": "fincontrol",
  "displayName": "FinControl",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 86400,
  "roles": {
    "realm": [
      { "name": "USER", "description": "Usuário do FinControl (área operacional)" },
      { "name": "ADMIN", "description": "Administrador do FinControl (área administrativa)" }
    ]
  },
  "clients": [
    {
      "clientId": "fincontrol-backend",
      "name": "FinControl back-end",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "fincontrol-dev-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "id": "0f1c2a3b-0000-4000-8000-000000000001",
