# Modelo do .env: copie para .env (Linux/macOS: cp .env.example .env | Windows: copy .env.example .env).
# Os valores abaixo sao os de DESENVOLVIMENTO; so DB_PASSWORD precisa ser a senha do seu PostgreSQL local.
# Nunca coloque segredos reais (producao) neste arquivo: ele vai para o repositorio.
# Lido pelo Quarkus (./mvnw quarkus:dev) e pelo docker compose.

# banco de dados
DB_USERNAME=postgres
DB_PASSWORD=troque-aqui
DB_URL=jdbc:postgresql://localhost:5432/topicos2db
# drop-and-create apaga o banco a cada subida; em producao: none ou validate
DB_GENERATION=drop-and-create
# em producao use no-file para nao carregar dados de exemplo
DB_LOAD_SCRIPT=referencia.sql,import.sql
LOG_SQL=true

# API
CORS_ORIGINS=http://localhost:4200
PROBLEM_BASE_URL=http://localhost:8080

# Keycloak (back-end)
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=fincontrol
KEYCLOAK_CLIENT_ID=fincontrol-backend
# secret do realm de dev (keycloak/fincontrol-realm.json, ja publico); em producao gere outro
KEYCLOAK_CLIENT_SECRET=fincontrol-dev-secret
KEYCLOAK_FRONTEND_CLIENT_ID=fincontrol-frontend

# cookie da sessao (refresh token): false so em desenvolvimento, sem HTTPS
AUTH_COOKIE_SECURE=false

# Keycloak (admin do container, docker-compose.yml)
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin

# autenticacao no modo dev: false libera os endpoints sem o Keycloak
FINCONTROL_AUTH=true
AUTH_DEV_FALLBACK_EMAIL=joao@email.com

# servicos e rotinas
VIACEP_URL=https://viacep.com.br
CEP_API_EXTERNA=true
COBRANCA_CRON=0 0 3 * * ?

# Object Storage S3 (SeaweedFS do docker-compose.yml): imagens dos planos.
# Credenciais de DESENVOLVIMENTO. O SeaweedFS so as le na primeira subida: para troca-las depois,
# apague o volume (docker compose down -v apaga TODOS os volumes, inclusive o do PostgreSQL).
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=fincontrol
S3_ACCESS_KEY=fincontrol
S3_SECRET_KEY=fincontrol-dev-secret
